# Copy this file to .env and fill in your own OpenRouter API key.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id used by the /chat endpoint. Defaults to
# google/gemma-4-31b-it when unset (the :free tier hits shared rate
# limits often enough to make it unreliable for local dev).
CHAT_MODEL=google/gemma-4-31b-it
